{
  "name": "freeze",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app lib scripts proxy.ts",
    "format": "oxfmt",
    "postinstall": "node scripts/prepare-ffmpeg.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:access && npm run test:batch && npm run test:camera && node --experimental-strip-types scripts/test-edit.mjs",
    "test:batch": "node --experimental-strip-types scripts/test-batch.mjs",
    "test:access": "node --experimental-strip-types scripts/test-access.mjs",
    "test:camera": "node --experimental-strip-types scripts/test-camera.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "next": "16.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.4"
  },
  "license": "MIT",
  "description": "Freeze a moment in your video, move the camera around it, then let life carry on."
